# Fauri Production Environment Template
APP_NAME=Fauri
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.onrender.com

# Database (Default: SQLite file or MySQL for cloud)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite
# DB_CONNECTION=mysql
# DB_HOST=your-mysql-host.aivencloud.com
# DB_PORT=3306
# DB_DATABASE=fauri
# DB_USERNAME=avnadmin
# DB_PASSWORD=your_password

# Drivers (Using database tables for zero external dependency on free tier)
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# File Storage
FILESYSTEM_DISK=public

# Fauri AI Service Endpoint
# Set to your Hugging Face Space URL (Public or with Bearer Token)
AI_SERVICE_URL=https://your-hf-username-fauri-ai.hf.space
AI_SERVICE_TIMEOUT=30

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=info
